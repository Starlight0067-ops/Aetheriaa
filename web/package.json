{
  "name": "aetheria-web",
  "private": true,
  "version": "0.2.0",
  "description": "AETHERIA - original anime open-world action RPG (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.js && node -e \"import('node:fs').then(f=>f.renameSync('dist-single/index.html','dist-single/aetheria.html'))\"",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve:dist": "vite preview --host",
    "shoot": "node tools/shoot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
